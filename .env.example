# ─── Shared / API ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aisaf?schema=public
JWT_SECRET=replace-with-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:3000
# REDIS_URL=redis://localhost:6379

# ─── apps/web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-string

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Payments — Phase 2/3 only (rules.md §5.3)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# JAZZCASH_* /
# EASYPAISA_*

# Images / email — later phases
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RESEND_API_KEY=
